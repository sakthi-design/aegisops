# Environment Configuration
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api

# Database (Default: SQLite, for Postgres: postgresql://user:pass@localhost:5432/incident_platform)
DATABASE_URL=sqlite:///./data/incident_platform.db

# LLM Providers (supports: mock, gemini, openai, ollama)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
MAX_CRITIC_RETRIES=3

# Security & Sanitization
PII_MASKING_ENABLED=true
SECRET_MASKING_ENABLED=true
AUDIT_LOG_ENABLED=true
